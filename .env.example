# =============================================================================
# AWWALSHOP — Environment Variables
# Copy this file to `.env` and adjust the values for your machine.
# Never commit `.env` — it is ignored by Git.
# =============================================================================

# DATABASE — local Docker URLs; use Supabase pooler URLs in Vercel.
DATABASE_URL="postgresql://awwalshop:awwalshop_dev_password@localhost:5434/awwalshop?schema=public"
DIRECT_URL="postgresql://awwalshop:awwalshop_dev_password@localhost:5434/awwalshop?schema=public"

# AUTH (NextAuth v5 / Auth.js)
# Generate a secret with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-secret-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# CLOUDINARY (optional for local development)
# Uploads are disabled until these are replaced with real credentials.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# BUSINESS (public)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="+2349152272117"
NEXT_PUBLIC_BUSINESS_NAME="AWWALSHOP"

# ANALYTICS — storefront tracking is enabled only for IDs provided here
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""

# INITIAL ADMIN — the email selects the admin account; only the password is requested at sign-in.
# Used by prisma/seed.ts and the password-only admin login (change before deploying).
ADMIN_EMAIL="admin@awwalshop.com"
ADMIN_PASSWORD="Awwalshop@2026"
