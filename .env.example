# =============================================================================
# AWWALSHOP — Environment Variables
# Copy this file to `.env` and adjust the values for your machine.
# Never commit `.env` — it is ignored by Git.
# =============================================================================

# DATABASE — Supabase Postgres
# Use the transaction pooler (port 6543) for DATABASE_URL and the session
# pooler (port 5432) for DIRECT_URL. Find both in the Supabase dashboard under
# Project Settings → Database → Connection string.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Offline/local alternative (Docker): comment out the two lines above and use:
# DATABASE_URL="postgresql://awwalshop:awwalshop_dev_password@localhost:5434/awwalshop?schema=public"
# DIRECT_URL="postgresql://awwalshop:awwalshop_dev_password@localhost:5434/awwalshop?schema=public"

# AUTH (NextAuth v5 / Auth.js)
# Generate a secret with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-secret-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# SUPABASE STORAGE (optional for local development)
# Server-side uploads use the service role key — never expose it with NEXT_PUBLIC_.
# Create the public bucket with supabase/migrations/20261119000000_create_product_media_bucket.sql
# (or run that SQL in the Supabase SQL Editor) before enabling uploads.
SUPABASE_URL="https://erjrpdzaoizfqdkzncoo.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="product-media"
# Optional (Pro+): store 400x400 Supabase-transformed image thumbnails.
SUPABASE_IMAGE_TRANSFORMATIONS="false"

# BUSINESS (public)
NEXT_PUBLIC_SITE_URL="https://awwalshop.vercel.app"
NEXT_PUBLIC_WHATSAPP_NUMBER="+2349152272117"
NEXT_PUBLIC_BUSINESS_NAME="AWWALSHOP"

# ANALYTICS — storefront tracking is enabled only for IDs provided here
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""

# INITIAL ADMIN — the email selects the admin account; only the password is requested at sign-in.
# Used by prisma/seed.ts and the password-only admin login (change before deploying).
ADMIN_EMAIL="admin@awwalshop.com"
ADMIN_PASSWORD="AwwalShop@2026"
